    "method": "histogram_overlap_per_metric",
    "weights": {
      "slope_deg": 0.5,
      "roughness_m": 0.5,
      "temp_diurnal_range_K": 0.0
    },
    "weights_note": "Slope and roughness are the scored core: same DEM method and window on both bodies. Temperature range is shown as context and has weight 0 by default because no Earth site can match permanently shadowed lunar temperatures and Diviner (240 m) and MODIS (1 km) differ in scale. Users may raise it with the slider only if real values are loaded. Missing metrics are not scored and never imputed. Index is relative, not a probability.",
    "show_rank_stability": true
  },
  "global_limitations": [
    "Earth cannot reproduce lunar gravity, vacuum, or radiation.",
    "No Earth site matches permanently shadowed region temperatures.",
    "Lunar 5 m DEM is about 90% interpolated; median RMS slope error about 1.5-2.5 deg. Resample both sides to 30 m.",
    "Earth DEMs are surface models (vegetation/ice included); MODIS is 1 km, Diviner polar grids are 240 m.",
    "Mineralogy is shown separately and is never part of the terrain score."
  ],
